# Frontend environment variables (Vite — embedded at build time)

# Backend API base URL (must include /api suffix)
# Local:   http://localhost:3001/api
# Vercel:  https://YOUR-BACKEND-PROJECT.vercel.app/api
VITE_API_URL=http://localhost:3001/api

# Mock mode: set to "true" for offline UI-only development (no backend required).
# Omit or set to "false" for real backend (recommended for integration, demos, production).
VITE_USE_MOCK=false
