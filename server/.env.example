# PostgreSQL connection string — set USER, PASSWORD, HOST, PORT for your install
# Local example (some Windows installs use port 5433):
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/fleet_monitor

# Hosted Postgres (Neon, Supabase, Render, etc.) — often includes ?sslmode=require:
# DATABASE_URL=postgresql://user:password@host:5432/fleet_monitor?sslmode=require

# Server port (local development only; Vercel sets this automatically)
PORT=3001

# Allowed frontend origin(s), comma-separated
# Local:   http://localhost:5173
# Vercel:  https://YOUR-FRONTEND-PROJECT.vercel.app
# Both:    https://YOUR-FRONTEND-PROJECT.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# TLS for PostgreSQL. Set to "true" when your provider requires SSL.
# Auto-enabled when DATABASE_URL contains sslmode=require (common on hosted providers).
DATABASE_SSL=false

# development | production
NODE_ENV=development
